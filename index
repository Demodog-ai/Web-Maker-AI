<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>App Designer - Standalone</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; margin: 0; padding: 0; }
        .scrollbar-thin::-webkit-scrollbar { width: 6px; }
        .scrollbar-thin::-webkit-scrollbar-track { background: transparent; }
        .scrollbar-thin::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
        .scrollbar-thin:hover::-webkit-scrollbar-thumb { background: #cbd5e1; }
        
        /* Animation utilities for the designer UI */
        .animate-in { animation: animateIn 0.2s ease-out; }
        .fade-in { opacity: 0; animation: fadeIn 0.3s forwards; }
        .zoom-in-95 { transform: scale(0.95); animation: zoomIn 0.3s forwards; }
        .slide-in-from-top-1 { transform: translateY(-4px); animation: slideIn 0.2s forwards; }
        .slide-in-from-bottom-2 { transform: translateY(8px); animation: slideInBottom 0.3s forwards; }

        @keyframes animateIn { from { opacity: 0; } to { opacity: 1; } }
        @keyframes fadeIn { to { opacity: 1; } }
        @keyframes zoomIn { to { transform: scale(1); opacity: 1; } }
        @keyframes slideIn { to { transform: translateY(0); opacity: 1; } }
        @keyframes slideInBottom { to { transform: translateY(0); opacity: 1; } }
    </style>
</head>
<body>
    <div id="root"></div>

    <!-- React and Babel CDN -->
    <script src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>

    <script type="text/babel">
        const { useState, useEffect, useMemo, useRef } = React;

        /**
         * Local SVG-based Icons to avoid Lucide-React UMD initialization errors
         */
        const Icon = ({ name, size = 20, className = "" }) => {
            const paths = {
                Plus: <path d="M12 5v14M5 12h14" />,
                Trash2: <g><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></g>,
                Code: <path d="m16 18 6-6-6-6M8 6l-6 6 6 6" />,
                Eye: <g><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></g>,
                Utensils: <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2M7 2v20M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />,
                Globe: <g><circle cx="12" cy="12" r="10"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/><path d="M2 12h20"/></g>,
                ImageIcon: <g><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></g>,
                Copy: <g><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></g>,
                Check: <path d="M20 6 9 17l-5-5" />,
                Palette: <g><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.6-.7 1.6-1.6 0-.4-.2-.8-.5-1.1-.3-.3-.5-.7-.5-1.1 0-.9.7-1.6 1.6-1.6H19c2.2 0 4-1.8 4-4 0-5.5-4.5-10-10-10z"/><circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/></g>,
                Layers: <g><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/></g>,
                X: <path d="M18 6 6 18M6 6l12 12" />,
                RefreshCw: <g><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></g>
            };

            return (
                <svg 
                    width={size} 
                    height={size} 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    strokeWidth="2" 
                    strokeLinecap="round" 
                    strokeLinejoin="round" 
                    className={className}
                >
                    {paths[name] || null}
                </svg>
            );
        };

        const App = () => {
            // --- Initial Default Data ---
            const DEFAULT_HTML_TEMPLATE = (hotelName, webhook, menuData, primary, secondary, isGradient) => `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${hotelName} - Order App</title>
    <script src="https://cdn.tailwindcss.com"><\/script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: ${primary};
            --secondary-color: ${secondary};
            --gradient: ${isGradient ? `linear-gradient(to right bottom, ${primary}, ${secondary})` : primary};
        }
        body { font-family: 'Inter', sans-serif; background-color: #f7f3e8; min-height: 100vh; }
        #app { max-width: 500px; margin: 0 auto; min-height: 100vh; display: flex; flex-direction: column; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); background-color: #ffffff; }
        
        .header-style { 
            background: var(--gradient); 
            color: white; 
            padding: 1.5rem 0; 
            text-align: center; 
            border-bottom-left-radius: 1.5rem; 
            border-bottom-right-radius: 1.5rem; 
            font-family: 'Poppins', sans-serif; 
        }

        .btn-primary {
            background: var(--gradient);
            color: white;
            transition: opacity 0.2s;
        }
        .btn-primary:hover { opacity: 0.9; }
        
        .text-accent { color: var(--primary-color); }
        .border-accent { border-color: var(--primary-color); }

        @keyframes pulse-once { 0% { transform: scale(1); } 70% { transform: scale(1.02); } 100% { transform: scale(1); } }
        .cta-pulse { animation: pulse-once 1.5s ease-out 1; }
        @keyframes spin { to { transform: rotate(360deg); } }
        .spinner { display: inline-block; width: 50px; height: 50px; border: 4px solid rgba(0, 0, 0, 0.1); border-radius: 50%; border-top-color: var(--primary-color); animation: spin 1s linear infinite; }
        @keyframes fadeInSlideUp { 0% { opacity: 0; transform: translateY(10px); } 100% { opacity: 1; transform: translateY(0); } }
        .menu-item-animate { animation: fadeInSlideUp 0.3s ease-out; animation-fill-mode: both; }
        .item-container:not(:last-child) { border-bottom: 1px solid #e5e7eb; }
        .active-tab { 
            background: var(--gradient); 
            color: white; 
            border-radius: 9999px; 
            box-shadow: 0 4px 8px -2px rgb(0 0 0 / 0.2); 
        }
    </style>
</head>
<body class="p-0 m-0">
    <div id="app" class="relative"></div>
    <script>
        const WEBHOOK_URL = '${webhook}'; 
        const HOTEL_NAME = '${hotelName}';
        const menu = ${JSON.stringify(menuData, null, 2)};

        let cart = {};
        let currentCategory = Object.keys(menu)[0] || '';
        let customerDetails = { name: '', contact: '', tableNumber: '', instructions: '' };

        function renderScreen(contentHtml) { document.getElementById('app').innerHTML = contentHtml; }

        function calculateTotal() {
            let total = 0;
            const orderedItems = [];
            for (const category in menu) {
                menu[category].forEach(item => {
                    const quantity = cart[item.id] || 0;
                    if (quantity > 0) {
                        const itemTotal = item.price * quantity;
                        total += itemTotal;
                        orderedItems.push({ itemId: item.id, name: item.name, price: item.price, quantity, subtotal: itemTotal });
                    }
                });
            }
            return { total, items: orderedItems };
        }

        function showWelcomeScreen() {
            renderScreen(\`
                <div class="flex-grow flex flex-col justify-center items-center p-8 text-center bg-gray-50">
                    <div class="bg-white p-8 rounded-2xl shadow-2xl w-full max-sm border border-gray-100">
                        <h1 class="text-4xl font-extrabold text-gray-900 mb-2 font-['Poppins']">\${HOTEL_NAME}</h1>
                        <p class="text-gray-600 mb-8 italic">Delicious taste, delivered with care.</p>
                        <button onclick="showMenuScreen()" class="w-full py-4 px-6 btn-primary font-bold rounded-full shadow-lg cta-pulse font-['Poppins'] text-lg">Start Ordering</button>
                    </div>
                </div>
            \`);
        }

        function showMenuScreen() {
            if (Object.keys(menu).length === 0) {
                 renderScreen('<div class="p-8 text-center">Menu is empty.</div>');
                 return;
            }
            if (!menu[currentCategory]) currentCategory = Object.keys(menu)[0];

            const menuHtml = menu[currentCategory].map((item, index) => \`
                <div class="item-container flex items-center p-4 menu-item-animate" style="animation-delay: \${index * 0.05}s;">
                    <div class="flex-shrink-0 mr-4">
                        <img src="\${item.image}" alt="\${item.name}" class="w-20 h-20 object-cover rounded-xl shadow-md border border-gray-100" onerror="this.src='https://placehold.co/80x80/E5E7EB/9CA3AF?text=Food'" />
                    </div>
                    <div class="flex-1 min-w-0 pr-3">
                        <p class="text-lg font-semibold text-gray-800 truncate">\${item.name}</p>
                        <p class="text-sm text-gray-500 truncate mb-1">\${item.description}</p>
                        <p class="text-lg font-bold text-green-600">₹\${item.price}</p>
                    </div>
                    <div class="flex items-center space-x-2 border border-gray-300 rounded-full flex-shrink-0 p-1">
                        <button onclick="updateQuantity(\${item.id}, -1)" class="w-8 h-8 flex items-center justify-center rounded-full text-lg font-bold text-red-500 hover:bg-red-50">-</button>
                        <span id="qty-\${item.id}" class="w-6 text-center text-gray-800 font-bold text-sm">\${cart[item.id] || 0}</span>
                        <button onclick="updateQuantity(\${item.id}, 1)" class="w-8 h-8 flex items-center justify-center rounded-full text-lg font-bold text-green-500 hover:bg-green-50">+</button>
                    </div>
                </div>
            \`).join('');

            const tabs = Object.keys(menu).map(cat => \`
                <button onclick="changeCategory('\${cat}')" class="p-2 px-4 text-sm font-semibold whitespace-nowrap \${currentCategory === cat ? 'active-tab' : 'text-gray-600'}">\${cat}</button>
            \`).join('');

            const totalInfo = calculateTotal();
            renderScreen(\`
                <header class="sticky top-0 z-10 header-style shadow-lg"><h2 class="text-2xl font-bold">\${HOTEL_NAME}</h2></header>
                <div class="sticky top-[5.5rem] z-10 bg-white/80 backdrop-blur-md shadow-sm overflow-x-auto p-3 flex space-x-3 border-b">\${tabs}</div>
                <div class="flex-grow overflow-y-auto pb-24">\${menuHtml}</div>
                <footer class="fixed bottom-0 w-full max-w-[500px] bg-white p-4 shadow-[0_-10px_20px_rgba(0,0,0,0.05)] border-t border-gray-100">
                    <div class="flex justify-between items-center mb-3 px-1"><span class="text-gray-500 font-medium">Order Total:</span><span id="menu-total" class="text-2xl font-black text-accent">₹\${totalInfo.total}</span></div>
                    <button onclick="if(calculateTotal().total > 0) showDetailsScreen()" class="w-full py-4 \${totalInfo.total > 0 ? 'btn-primary' : 'bg-gray-300'} text-white font-bold rounded-2xl transition-all shadow-md">Done Ordering (\${totalInfo.items.length} items)</button>
                </footer>
            \`);
        }

        function changeCategory(cat) { currentCategory = cat; showMenuScreen(); }
        function updateQuantity(id, delta) { cart[id] = Math.max(0, (cart[id] || 0) + delta); showMenuScreen(); }

        function showDetailsScreen() {
            const totalInfo = calculateTotal();
            const summary = totalInfo.items.map(item => \`<li class="flex justify-between py-2 border-b border-dashed border-gray-200"><span class="text-gray-700 font-medium">\${item.name} (x\${item.quantity})</span><span class="font-bold text-gray-900">₹\${item.subtotal}</span></li>\`).join('');
            renderScreen(\`
                <header class="header-style p-4 flex items-center shadow-md relative"><button onclick="showMenuScreen()" class="absolute left-4 text-white text-2xl font-bold">&larr;</button><h2 class="w-full text-xl font-bold">Checkout</h2></header>
                <div class="p-5 flex-grow overflow-y-auto">
                    <div class="bg-white p-5 rounded-2xl shadow-xl border border-gray-100 mb-6">
                        <h3 class="text-lg font-bold text-gray-800 mb-3 flex items-center gap-2">Summary</h3><ul class="space-y-1">\${summary}</ul>
                        <div class="flex justify-between items-center pt-4 mt-2 border-t-2 border-accent/20"><span class="font-bold text-gray-600">Total Amount</span><span class="text-3xl font-black text-accent">₹\${totalInfo.total}</span></div>
                    </div>
                    <form id="detailsForm" class="space-y-4">
                        <div><label class="text-xs font-bold text-gray-400 uppercase ml-1">Your Name</label><input type="text" id="name" required placeholder="Full Name" class="w-full rounded-xl border border-gray-200 p-3 mt-1 focus:ring-2 focus:ring-accent/50 outline-none" value="\${customerDetails.name}" /></div>
                        <div><label class="text-xs font-bold text-gray-400 uppercase ml-1">Contact Number</label><input type="tel" id="contact" required placeholder="Phone Number" class="w-full rounded-xl border border-gray-200 p-3 mt-1 focus:ring-2 focus:ring-accent/50 outline-none" value="\${customerDetails.contact}" /></div>
                        <div><label class="text-xs font-bold text-gray-400 uppercase ml-1">Table No.</label><input type="number" id="tableNumber" required placeholder="e.g. 5" class="w-full rounded-xl border border-gray-200 p-3 mt-1 focus:ring-2 focus:ring-accent/50 outline-none" value="\${customerDetails.tableNumber}" /></div>
                        <div><label class="text-xs font-bold text-gray-400 uppercase ml-1">Cooking Instructions</label><textarea id="instructions" placeholder="Any preferences?" class="w-full rounded-xl border border-gray-200 p-3 mt-1 focus:ring-2 focus:ring-accent/50 outline-none">\${customerDetails.instructions}</textarea></div>
                    </form>
                </div>
                <footer class="sticky bottom-0 bg-white p-4 border-t"><button onclick="submitOrder()" class="w-full py-4 btn-primary text-white font-bold rounded-2xl shadow-lg">Confirm & Send Order</button></footer>
            \`);
        }

        async function submitOrder() {
            const form = document.getElementById('detailsForm');
            if (!form.checkValidity()) { form.reportValidity(); return; }
            customerDetails = { name: document.getElementById('name').value, contact: document.getElementById('contact').value, tableNumber: document.getElementById('tableNumber').value, instructions: document.getElementById('instructions').value };
            const orderData = calculateTotal();
            const payload = { hotelName: HOTEL_NAME, timestamp: new Date().toISOString(), customer: customerDetails, order: orderData.items, grandTotal: orderData.total };
            
            renderScreen('<div class="flex-grow flex flex-col justify-center items-center p-8"><div class="spinner"></div><p class="mt-4 font-bold text-gray-500 uppercase tracking-widest text-xs">Sending to Kitchen...</p></div>');
            try {
                const resp = await fetch(WEBHOOK_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                if (resp.ok) showConfirmationScreen(customerDetails.tableNumber);
                else throw new Error();
            } catch {
                renderScreen('<div class="flex-grow flex flex-col justify-center items-center p-8 text-center"><h1 class="text-red-600 text-3xl font-black mb-2">Oops!</h1><p class="text-gray-500 mb-6">Failed to send order.</p><button onclick="showDetailsScreen()" class="btn-primary p-4 rounded-xl px-8 font-bold">Retry Now</button></div>');
            }
        }

        function showConfirmationScreen(table) {
            cart = {};
            renderScreen('<div class="flex-grow flex flex-col justify-center items-center p-8 text-center"><div class="w-20 h-20 bg-green-100 text-green-600 rounded-full flex items-center justify-center mb-6"><svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg></div><h1 class="text-4xl text-gray-900 font-black mb-2">Order Success</h1><p class="text-xl text-gray-500">Serving Table #'+table+'</p><button onclick="showWelcomeScreen()" class="mt-10 btn-primary p-4 rounded-full px-12 font-bold shadow-xl">New Order</button></div>');
        }

        window.onload = showWelcomeScreen;
    <\/script>
</body>
</html>`;

            // --- State ---
            const [hotelName, setHotelName] = useState('Raju da dhaba');
            const [webhookUrl, setWebhookUrl] = useState('https://n8n.srv1234891.hstgr.cloud/webhook/Menu');
            const [primaryColor, setPrimaryColor] = useState('#4f46e5');
            const [secondaryColor, setSecondaryColor] = useState('#312e81');
            const [isGradient, setIsGradient] = useState(true);
            
            const [menu, setMenu] = useState({
                Starter: [
                { id: 101, name: "Paneer Tikka", price: 280, description: "Smoky cottage cheese cubes", image: "https://raw.githubusercontent.com/kaushalborse38-maker/helpmeorder/main/Paneer%20Tikka.jpeg" },
                { id: 102, name: "Crispy Corn", price: 220, description: "Fried corn kernels", image: "https://raw.githubusercontent.com/kaushalborse38-maker/helpmeorder/main/Crispy%20Corn.jpeg" },
                ],
                Maincourse: [
                { id: 201, name: "Dal Makhani", price: 350, description: "Creamy black lentil curry", image: "https://raw.githubusercontent.com/kaushalborse38-maker/helpmeorder/main/Dal%20Makhani.jpeg" },
                ]
            });

            const [viewMode, setViewMode] = useState('preview'); 
            const [activeCategory, setActiveCategory] = useState('Starter');
            const [copyStatus, setCopyStatus] = useState(false);
            const [isAddingCategory, setIsAddingCategory] = useState(false);
            const [newCatName, setNewCatName] = useState('');

            // --- Computed Values ---
            const generatedCode = useMemo(() => {
                return DEFAULT_HTML_TEMPLATE(hotelName, webhookUrl, menu, primaryColor, secondaryColor, isGradient);
            }, [hotelName, webhookUrl, menu, primaryColor, secondaryColor, isGradient]);

            // --- Handlers ---
            const handleCopyCode = () => {
                try {
                    const textArea = document.createElement("textarea");
                    textArea.value = generatedCode;
                    textArea.style.position = "fixed";
                    textArea.style.left = "-9999px";
                    textArea.style.top = "0";
                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();
                    const successful = document.execCommand('copy');
                    document.body.removeChild(textArea);
                    if (successful) {
                        setCopyStatus(true);
                        setTimeout(() => setCopyStatus(false), 2000);
                    }
                } catch (err) {
                    console.error('Failed to copy code: ', err);
                }
            };

            const addCategory = () => {
                if (newCatName && !menu[newCatName]) {
                    setMenu({ ...menu, [newCatName]: [] });
                    setActiveCategory(newCatName);
                    setNewCatName('');
                    setIsAddingCategory(false);
                }
            };

            const deleteCategory = (catName) => {
                const newMenu = { ...menu };
                delete newMenu[catName];
                setMenu(newMenu);
                if (activeCategory === catName) {
                    setActiveCategory(Object.keys(newMenu)[0] || '');
                }
            };

            const addItem = (catName) => {
                const newItem = {
                    id: Date.now(),
                    name: "New Dish",
                    price: 0,
                    description: "Description here",
                    image: "https://placehold.co/150"
                };
                setMenu({
                    ...menu,
                    [catName]: [...menu[catName], newItem]
                });
            };

            // Helper to fix GitHub URLs
            const fixImageUrl = (url) => {
                if (url.includes('github.com') && url.includes('/blob/')) {
                    return url
                        .replace('github.com', 'raw.githubusercontent.com')
                        .replace('/blob/', '/');
                }
                return url;
            };

            const updateItem = (catName, itemId, field, value) => {
                const newMenu = { ...menu };
                const items = [...newMenu[catName]];
                const index = items.findIndex(i => i.id === itemId);
                
                let processedValue = value;
                if (field === 'price') processedValue = parseFloat(value) || 0;
                if (field === 'image') processedValue = fixImageUrl(value); // Auto-fix GitHub links

                items[index] = { ...items[index], [field]: processedValue };
                newMenu[catName] = items;
                setMenu(newMenu);
            };

            const deleteItem = (catName, itemId) => {
                setMenu({
                    ...menu,
                    [catName]: menu[catName].filter(i => i.id !== itemId)
                });
            };

            return (
                <div className="flex flex-col h-screen bg-slate-50 text-slate-900 font-sans overflow-hidden">
                    {/* Top Navbar */}
                    <header className="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between shadow-sm z-10">
                        <div className="flex items-center gap-2">
                            <div className="bg-indigo-600 p-1.5 rounded-lg shadow-md">
                                <Icon name="Utensils" className="text-white" />
                            </div>
                            <h1 className="font-bold text-xl tracking-tight">App Designer</h1>
                        </div>

                        <div className="flex items-center bg-slate-100 rounded-full p-1 border border-slate-200">
                            <button 
                                onClick={() => setViewMode('preview')}
                                className={`flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium transition-all ${viewMode === 'preview' ? 'bg-white shadow-sm text-indigo-600' : 'text-slate-500 hover:text-slate-700'}`}
                            >
                                <Icon name="Eye" size={16} /> Live Preview
                            </button>
                            <button 
                                onClick={() => setViewMode('code')}
                                className={`flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium transition-all ${viewMode === 'code' ? 'bg-white shadow-sm text-indigo-600' : 'text-slate-500 hover:text-slate-700'}`}
                            >
                                <Icon name="Code" size={16} /> Get Code
                            </button>
                        </div>

                        <button 
                            onClick={handleCopyCode}
                            className="flex items-center gap-2 px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-medium text-sm transition-colors shadow-sm"
                        >
                            <Icon name={copyStatus ? "Check" : "Copy"} size={16} />
                            {copyStatus ? 'Copied!' : 'Copy Result'}
                        </button>
                    </header>

                    <main className="flex flex-1 overflow-hidden">
                        {/* Left Panel */}
                        <aside className="w-96 bg-white border-r border-slate-200 flex flex-col overflow-hidden shadow-sm">
                            <div className="flex-1 overflow-y-auto p-5 space-y-8 scrollbar-thin">
                                
                                {/* General Settings */}
                                <section className="space-y-4">
                                    <h2 className="text-xs font-bold text-slate-400 uppercase tracking-widest flex items-center gap-2">
                                        <Icon name="Globe" size={14} /> General Configuration
                                    </h2>
                                    <div className="space-y-3">
                                        <div className="space-y-1">
                                            <label className="text-xs font-semibold text-slate-600 ml-1">Restaurant Name</label>
                                            <input 
                                                type="text" 
                                                value={hotelName}
                                                onChange={(e) => setHotelName(e.target.value)}
                                                className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none transition-all"
                                            />
                                        </div>
                                        <div className="space-y-1">
                                            <label className="text-xs font-semibold text-slate-600 ml-1">Webhook URL</label>
                                            <input 
                                                type="text" 
                                                value={webhookUrl}
                                                onChange={(e) => setWebhookUrl(e.target.value)}
                                                className="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-lg text-sm font-mono text-xs focus:ring-2 focus:ring-indigo-500 outline-none transition-all"
                                            />
                                        </div>
                                    </div>
                                </section>

                                {/* Design Customization */}
                                <section className="space-y-4">
                                    <h2 className="text-xs font-bold text-slate-400 uppercase tracking-widest flex items-center gap-2">
                                        <Icon name="Palette" size={14} /> Design & Theme
                                    </h2>
                                    <div className="bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-4">
                                        <div className="flex items-center justify-between">
                                            <label className="text-xs font-bold text-slate-600 uppercase">Fill Type</label>
                                            <div className="flex bg-slate-200 p-0.5 rounded-lg text-[10px] font-bold">
                                                <button 
                                                    onClick={() => setIsGradient(false)}
                                                    className={`px-3 py-1 rounded-md ${!isGradient ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500'}`}
                                                >SOLID</button>
                                                <button 
                                                    onClick={() => setIsGradient(true)}
                                                    className={`px-3 py-1 rounded-md ${isGradient ? 'bg-white text-indigo-600 shadow-sm' : 'text-slate-500'}`}
                                                >GRADIENT</button>
                                            </div>
                                        </div>

                                        <div className="grid grid-cols-2 gap-4">
                                            <div className="space-y-1.5">
                                                <label className="text-[10px] font-bold text-slate-400 uppercase ml-1">Primary Color</label>
                                                <div className="flex items-center gap-2">
                                                    <input 
                                                        type="color" 
                                                        value={primaryColor}
                                                        onChange={(e) => setPrimaryColor(e.target.value)}
                                                        className="w-10 h-10 rounded-lg border-2 border-white shadow-sm cursor-pointer p-0 overflow-hidden"
                                                    />
                                                    <span className="text-[10px] font-mono font-bold uppercase text-slate-500">{primaryColor}</span>
                                                </div>
                                            </div>
                                            
                                            {isGradient && (
                                                <div className="space-y-1.5 animate-in fade-in slide-in-from-top-1">
                                                    <label className="text-[10px] font-bold text-slate-400 uppercase ml-1">Secondary Color</label>
                                                    <div className="flex items-center gap-2">
                                                        <input 
                                                            type="color" 
                                                            value={secondaryColor}
                                                            onChange={(e) => setSecondaryColor(e.target.value)}
                                                            className="w-10 h-10 rounded-lg border-2 border-white shadow-sm cursor-pointer p-0 overflow-hidden"
                                                        />
                                                        <span className="text-[10px] font-mono font-bold uppercase text-slate-500">{secondaryColor}</span>
                                                    </div>
                                                </div>
                                            )}
                                        </div>

                                        <div className="pt-2 border-t border-slate-200">
                                            <div className="text-[10px] font-bold text-slate-400 uppercase mb-2">Live Theme Swatch</div>
                                            <div 
                                                className="w-full h-8 rounded-lg shadow-inner border border-slate-200 transition-all duration-300"
                                                style={{ 
                                                    background: isGradient 
                                                    ? `linear-gradient(to right, ${primaryColor}, ${secondaryColor})` 
                                                    : primaryColor 
                                                }}
                                            ></div>
                                        </div>
                                    </div>
                                </section>

                                {/* Menu Manager */}
                                <section className="space-y-4 pb-10">
                                    <div className="flex items-center justify-between">
                                        <h2 className="text-xs font-bold text-slate-400 uppercase tracking-widest flex items-center gap-2">
                                            <Icon name="Layers" size={14} /> Menu Manager
                                        </h2>
                                        {!isAddingCategory && (
                                            <button 
                                                onClick={() => setIsAddingCategory(true)}
                                                className="p-1.5 hover:bg-indigo-50 text-indigo-600 rounded-md transition-colors flex items-center gap-1 text-[10px] font-bold uppercase"
                                            >
                                                <Icon name="Plus" size={14} /> Add
                                            </button>
                                        )}
                                    </div>

                                    {/* Add Category Form */}
                                    {isAddingCategory && (
                                        <div className="bg-indigo-50 p-3 rounded-xl border border-indigo-100 flex items-center gap-2 animate-in slide-in-from-top-1 duration-200">
                                            <input 
                                                autoFocus
                                                type="text"
                                                placeholder="Category Name..."
                                                value={newCatName}
                                                onChange={(e) => setNewCatName(e.target.value)}
                                                onKeyDown={(e) => e.key === 'Enter' && addCategory()}
                                                className="flex-1 bg-white border border-indigo-200 rounded-lg px-3 py-1.5 text-sm outline-none focus:ring-2 focus:ring-indigo-500"
                                            />
                                            <button onClick={addCategory} className="p-1.5 bg-indigo-600 text-white rounded-lg"><Icon name="Check" size={16} /></button>
                                            <button onClick={() => setIsAddingCategory(false)} className="p-1.5 bg-slate-200 text-slate-600 rounded-lg"><Icon name="X" size={16} /></button>
                                        </div>
                                    )}

                                    {/* Categories Tabs */}
                                    <div className="flex flex-wrap gap-2 mb-4">
                                        {Object.keys(menu).map(cat => (
                                            <div key={cat} className="group relative">
                                                <button 
                                                    onClick={() => setActiveCategory(cat)}
                                                    className={`px-3 py-1.5 rounded-full text-xs font-semibold transition-all ${activeCategory === cat ? 'bg-indigo-100 text-indigo-700 ring-1 ring-indigo-200 shadow-sm' : 'bg-slate-100 text-slate-500 hover:bg-slate-200'}`}
                                                >
                                                    {cat}
                                                </button>
                                                <button 
                                                    onClick={() => deleteCategory(cat)}
                                                    className="absolute -top-1 -right-1 bg-white border border-slate-200 rounded-full p-0.5 opacity-0 group-hover:opacity-100 transition-opacity text-red-500 shadow-md z-10"
                                                >
                                                    <Icon name="Trash2" size={10} />
                                                </button>
                                            </div>
                                        ))}
                                    </div>

                                    {/* Items */}
                                    <div className="space-y-4">
                                        {activeCategory && menu[activeCategory]?.map(item => (
                                            <div key={item.id} className="p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-3 relative group">
                                                <button 
                                                    onClick={() => deleteItem(activeCategory, item.id)}
                                                    className="absolute top-2 right-2 p-1.5 text-slate-400 hover:text-red-500 hover:bg-white rounded-lg transition-all"
                                                >
                                                    <Icon name="Trash2" size={16} />
                                                </button>

                                                <div className="grid grid-cols-3 gap-2">
                                                    <div className="col-span-2 space-y-1">
                                                        <label className="text-[10px] font-bold text-slate-400 uppercase ml-1">Dish Name</label>
                                                        <input 
                                                            type="text" 
                                                            value={item.name}
                                                            onChange={(e) => updateItem(activeCategory, item.id, 'name', e.target.value)}
                                                            className="w-full px-2 py-1.5 text-sm bg-white border border-slate-200 rounded-md outline-none focus:border-indigo-500 shadow-sm"
                                                        />
                                                    </div>
                                                    <div className="space-y-1">
                                                        <label className="text-[10px] font-bold text-slate-400 uppercase ml-1">Price (₹)</label>
                                                        <input 
                                                            type="number" 
                                                            value={item.price}
                                                            onChange={(e) => updateItem(activeCategory, item.id, 'price', e.target.value)}
                                                            className="w-full px-2 py-1.5 text-sm bg-white border border-slate-200 rounded-md outline-none focus:border-indigo-500 font-semibold text-green-700 shadow-sm"
                                                        />
                                                    </div>
                                                </div>

                                                <div className="space-y-1">
                                                    <label className="text-[10px] font-bold text-slate-400 uppercase ml-1">Description</label>
                                                    <input 
                                                        type="text" 
                                                        value={item.description}
                                                        onChange={(e) => updateItem(activeCategory, item.id, 'description', e.target.value)}
                                                        className="w-full px-2 py-1.5 text-sm bg-white border border-slate-200 rounded-md outline-none focus:border-indigo-500 shadow-sm"
                                                    />
                                                </div>

                                                <div className="space-y-1">
                                                    <label className="text-[10px] font-bold text-slate-400 uppercase ml-1 flex items-center gap-1">
                                                        <Icon name="ImageIcon" size={10} /> Image URL 
                                                        {item.image.includes('raw.githubusercontent') && <span className="text-[8px] text-green-500 ml-auto">GitHub Optimized</span>}
                                                    </label>
                                                    <input 
                                                        type="text" 
                                                        value={item.image}
                                                        onChange={(e) => updateItem(activeCategory, item.id, 'image', e.target.value)}
                                                        className="w-full px-2 py-1.5 text-[10px] bg-white border border-slate-200 rounded-md outline-none font-mono focus:border-indigo-500 shadow-sm"
                                                    />
                                                </div>
                                            </div>
                                        ))}

                                        {activeCategory && (
                                            <button 
                                                onClick={() => addItem(activeCategory)}
                                                className="w-full py-4 border-2 border-dashed border-slate-200 rounded-xl text-slate-400 hover:text-indigo-600 hover:border-indigo-200 hover:bg-indigo-50 transition-all flex items-center justify-center gap-2 font-medium text-sm"
                                            >
                                                <Icon name="Plus" size={16} /> Add Dish to {activeCategory}
                                            </button>
                                        )}
                                    </div>
                                </section>
                            </div>
                        </aside>

                        {/* Right Panel */}
                        <section className="flex-1 bg-slate-100 flex items-center justify-center p-8 overflow-hidden">
                            {viewMode === 'preview' ? (
                                <div className="w-full h-full flex items-center justify-center scale-90 md:scale-100 animate-in zoom-in-95">
                                    <div className="relative w-[360px] h-[720px] bg-slate-900 rounded-[3rem] border-[10px] border-slate-900 shadow-2xl overflow-hidden flex flex-col">
                                        <div className="absolute top-0 left-1/2 -translate-x-1/2 w-32 h-6 bg-slate-900 rounded-b-2xl z-20"></div>
                                        <iframe 
                                            key={generatedCode} 
                                            srcDoc={generatedCode}
                                            title="Live Preview"
                                            className="w-full h-full bg-white z-10 border-none"
                                        />
                                    </div>
                                </div>
                            ) : (
                                <div className="w-full h-full max-w-4xl bg-slate-900 rounded-2xl shadow-2xl flex flex-col overflow-hidden border border-slate-700 animate-in slide-in-from-bottom-2">
                                    <div className="bg-slate-800 px-6 py-3 border-b border-slate-700 flex items-center justify-between">
                                        <div className="flex items-center gap-2">
                                            <div className="w-3 h-3 rounded-full bg-red-500"></div>
                                            <div className="w-3 h-3 rounded-full bg-yellow-500"></div>
                                            <div className="w-3 h-3 rounded-full bg-green-500"></div>
                                        </div>
                                        <span className="text-slate-400 text-xs font-mono tracking-tight">standalone_order_app.html</span>
                                    </div>
                                    <pre className="flex-1 p-6 overflow-auto text-indigo-300 font-mono text-[12px] leading-relaxed scrollbar-thin scrollbar-thumb-slate-700">
                                        <code>{generatedCode}</code>
                                    </pre>
                                </div>
                            )}
                        </section>
                    </main>
                </div>
            );
        };

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
